rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada cuenta solo puede leer y modificar su propio documento UCAL PRO.
    match /users/{userId}/workspaces/{workspaceId} {
      allow get: if request.auth != null
        && request.auth.uid == userId
        && workspaceId == "ucalTemplates";

      allow list: if false;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && workspaceId == "ucalTemplates"
        && request.resource.data.keys().hasOnly(["items", "updatedAt"])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }
  }
}